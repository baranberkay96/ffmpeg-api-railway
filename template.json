{
  "name": "FFmpeg 9 Media Processing API",
  "description": "FFmpeg REST API: convert, thumbnails, audio; queue workers, Bucket output.",
  "category": "Other",
  "tags": [
    "ffmpeg",
    "video",
    "audio",
    "transcoding",
    "media",
    "api",
    "thumbnails",
    "automation"
  ],
  "image": "https://upload.wikimedia.org/wikipedia/commons/7/76/FFmpeg_icon.svg",
  "upstream": {
    "ffmpeg": "FFmpeg 9.1 static build, mwader/static-ffmpeg:9.1@sha256:dd09509d8c2152bfa601c8c20e3dd166bde906d37951b9f7e8bbd922267f5ac9",
    "python": "python:3.13-slim-trixie@sha256:6d68eb6310a906f26c7638eb6ea7557d4261662df3181af2f80f1f9a7e34c549",
    "checked": "2026-11-24"
  },
  "services": {
    "FFmpeg API": {
      "icon": "https://upload.wikimedia.org/wikipedia/commons/7/76/FFmpeg_icon.svg",
      "source": {
        "repo": "baranberkay96/ffmpeg-api-railway",
        "rootDirectory": "/services/ffmpeg"
      },
      "startCommand": null,
      "preDeployCommand": null,
      "healthcheckPath": "/healthz",
      "healthcheckTimeout": 600,
      "restartPolicyType": "ALWAYS",
      "numReplicas": 1,
      "cronSchedule": null,
      "publicDomain": true,
      "targetPort": 8080,
      "tcpProxy": null,
      "volume": null,
      "variables": {
        "ROLE": {
          "defaultValue": "api",
          "description": "Process role of this service: api.",
          "required": true
        },
        "PORT": {
          "defaultValue": "8080",
          "description": "HTTP port of the API (public domain target and healthcheck).",
          "required": true
        },
        "API_KEY": {
          "defaultValue": "${{secret(48, \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789\")}}",
          "description": "API key, generated at deploy. Send it as 'Authorization: Bearer' or 'X-API-Key'. 16-256 characters, no spaces; anything else locks the API.",
          "required": true
        },
        "REDIS_URL": {
          "defaultValue": "${{Redis.REDIS_URL}}",
          "description": "Redis connection (job queue and job records).",
          "required": true
        },
        "S3_ENDPOINT": {
          "defaultValue": "${{Bucket.ENDPOINT}}",
          "description": "Railway Bucket S3 endpoint.",
          "required": false
        },
        "S3_REGION": {
          "defaultValue": "${{Bucket.REGION}}",
          "description": "Railway Bucket region.",
          "required": false
        },
        "S3_BUCKET": {
          "defaultValue": "${{Bucket.BUCKET}}",
          "description": "Railway Bucket name (uploads and outputs).",
          "required": false
        },
        "S3_ACCESS_KEY_ID": {
          "defaultValue": "${{Bucket.ACCESS_KEY_ID}}",
          "description": "Railway Bucket access key.",
          "required": false
        },
        "S3_SECRET_ACCESS_KEY": {
          "defaultValue": "${{Bucket.SECRET_ACCESS_KEY}}",
          "description": "Railway Bucket secret key.",
          "required": false
        },
        "MAX_INPUT_MB": {
          "defaultValue": "500",
          "description": "Largest upload or URL download per job, in MB.",
          "required": false
        },
        "MAX_OUTPUT_MB": {
          "defaultValue": "2000",
          "description": "Largest output file per job, in MB; FFmpeg stops at this size and the job fails.",
          "required": false
        },
        "JOB_TIMEOUT_SECONDS": {
          "defaultValue": "1800",
          "description": "Wall-clock limit per job; FFmpeg is stopped after it.",
          "required": false
        },
        "SYNC_WAIT_SECONDS": {
          "defaultValue": "300",
          "description": "How long /v1/run and /v1/probe wait for a result before answering 202 (max 840).",
          "required": false
        },
        "MAX_QUEUED_JOBS": {
          "defaultValue": "100",
          "description": "Queue length at which new jobs get HTTP 429.",
          "required": false
        },
        "RETENTION_HOURS": {
          "defaultValue": "24",
          "description": "Hours that job records and output files are kept before automatic deletion.",
          "required": false
        },
        "PRESIGNED_URL_SECONDS": {
          "defaultValue": "3600",
          "description": "Lifetime of the direct Bucket download URL returned with finished jobs.",
          "required": false
        },
        "ALLOW_CUSTOM_ARGS": {
          "defaultValue": "true",
          "description": "Allow the 'custom' operation (your own FFmpeg arguments, validated). false disables it.",
          "required": false
        }
      }
    },
    "FFmpeg Worker": {
      "icon": "https://upload.wikimedia.org/wikipedia/commons/7/76/FFmpeg_icon.svg",
      "source": {
        "repo": "baranberkay96/ffmpeg-api-railway",
        "rootDirectory": "/services/ffmpeg"
      },
      "startCommand": null,
      "preDeployCommand": null,
      "healthcheckPath": "/healthz",
      "healthcheckTimeout": 600,
      "restartPolicyType": "ALWAYS",
      "numReplicas": 1,
      "cronSchedule": null,
      "publicDomain": false,
      "targetPort": null,
      "tcpProxy": null,
      "volume": null,
      "variables": {
        "ROLE": {
          "defaultValue": "worker",
          "description": "Process role of this service: worker.",
          "required": true
        },
        "PORT": {
          "defaultValue": "8080",
          "description": "Private port of the worker's /healthz (healthcheck only, no public domain).",
          "required": true
        },
        "REDIS_URL": {
          "defaultValue": "${{Redis.REDIS_URL}}",
          "description": "Redis connection (job queue and job records).",
          "required": true
        },
        "S3_ENDPOINT": {
          "defaultValue": "${{Bucket.ENDPOINT}}",
          "description": "Railway Bucket S3 endpoint.",
          "required": false
        },
        "S3_REGION": {
          "defaultValue": "${{Bucket.REGION}}",
          "description": "Railway Bucket region.",
          "required": false
        },
        "S3_BUCKET": {
          "defaultValue": "${{Bucket.BUCKET}}",
          "description": "Railway Bucket name (uploads and outputs).",
          "required": false
        },
        "S3_ACCESS_KEY_ID": {
          "defaultValue": "${{Bucket.ACCESS_KEY_ID}}",
          "description": "Railway Bucket access key.",
          "required": false
        },
        "S3_SECRET_ACCESS_KEY": {
          "defaultValue": "${{Bucket.SECRET_ACCESS_KEY}}",
          "description": "Railway Bucket secret key.",
          "required": false
        },
        "MAX_INPUT_MB": {
          "defaultValue": "${{FFmpeg API.MAX_INPUT_MB}}",
          "description": "Largest URL download per job (same as the API).",
          "required": false
        },
        "MAX_OUTPUT_MB": {
          "defaultValue": "${{FFmpeg API.MAX_OUTPUT_MB}}",
          "description": "Largest output per job (same as the API).",
          "required": false
        },
        "JOB_TIMEOUT_SECONDS": {
          "defaultValue": "${{FFmpeg API.JOB_TIMEOUT_SECONDS}}",
          "description": "Wall-clock limit per job (same as the API).",
          "required": false
        },
        "RETENTION_HOURS": {
          "defaultValue": "${{FFmpeg API.RETENTION_HOURS}}",
          "description": "Outputs older than this are deleted from the Bucket.",
          "required": false
        },
        "WORKER_CONCURRENCY": {
          "defaultValue": "1",
          "description": "Jobs this worker runs at the same time. Prefer more replicas over a higher value.",
          "required": false
        },
        "FFMPEG_THREADS": {
          "defaultValue": "",
          "description": "Optional. Threads per FFmpeg job; empty = from the service's CPU limit (max 8).",
          "required": false
        },
        "ALLOW_PRIVATE_URLS": {
          "defaultValue": "false",
          "description": "Allow input/callback URLs on private networks (e.g. other Railway services). Keep false unless needed.",
          "required": false
        }
      }
    },
    "Redis": {
      "icon": "https://cdn.sanity.io/images/sy1jschh/production/0ce0bfdcfbdbf69662b1116671f97c2dd788b655-157x157.svg",
      "source": {
        "image": "redis:8.2.11@sha256:b0b01167ff47bc3868e56a967895a26be4230891a1f42a78ab61cdd227accc8d"
      },
      "startCommand": "/bin/sh -c \"rm -rf $RAILWAY_VOLUME_MOUNT_PATH/lost+found/ && exec docker-entrypoint.sh redis-server --requirepass $REDIS_PASSWORD --save 60 1 --dir $RAILWAY_VOLUME_MOUNT_PATH\"",
      "preDeployCommand": null,
      "healthcheckPath": null,
      "healthcheckTimeout": null,
      "restartPolicyType": "ON_FAILURE",
      "restartPolicyMaxRetries": 10,
      "numReplicas": 1,
      "cronSchedule": null,
      "publicDomain": false,
      "targetPort": null,
      "tcpProxy": null,
      "volume": {
        "mountPath": "/data"
      },
      "variables": {
        "REDISHOST": {
          "defaultValue": "${{RAILWAY_PRIVATE_DOMAIN}}",
          "description": "Private network hostname of the Redis service.",
          "required": false
        },
        "REDISPORT": {
          "defaultValue": "6379",
          "description": "Port that Redis listens on.",
          "required": false
        },
        "REDISUSER": {
          "defaultValue": "default",
          "description": "Username for authenticating with Redis.",
          "required": false
        },
        "REDIS_PASSWORD": {
          "defaultValue": "${{ secret(32, \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ\") }}",
          "description": "Randomly generated password for authenticating with Redis.",
          "required": false
        },
        "REDISPASSWORD": {
          "defaultValue": "${{REDIS_PASSWORD}}",
          "description": "Alias of REDIS_PASSWORD.",
          "required": false
        },
        "REDIS_URL": {
          "defaultValue": "redis://${{ REDISUSER }}:${{ REDIS_PASSWORD }}@${{ REDISHOST }}:${{ REDISPORT }}",
          "description": "Private connection URL used by the FFmpeg API and workers.",
          "required": false
        }
      }
    }
  },
  "buckets": [
    "Bucket"
  ]
}